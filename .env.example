# LLMark Environment Variables

# Groq API Key for Ask Expert LLM Copilot (LPU-Accelerated Llama 3.3 70B)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Provider Keys (Optional: can also be configured dynamically in the UI)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
